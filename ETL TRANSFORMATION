from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# Initialize Spark
spark = SparkSession.builder.appName("AWS_ETL_Pipeline").getOrCreate()

# S3 paths
raw_path = "s3://olist-data-gargi-mumbai/raw/"
processed_path = "s3://olist-data-processed/final/"

# Load datasets
orders = spark.read.option("header", "true") \
    .csv(raw_path + "olist_orders_dataset.csv")

order_items = spark.read.option("header", "true") \
    .csv(raw_path + "olist_order_items_dataset.csv")

customers = spark.read.option("header", "true") \
    .csv(raw_path + "olist_customers_dataset.csv")

# Join datasets
df = orders.join(order_items, "order_id") \
           .join(customers, "customer_id")

# Transformations
df = df.withColumn("price", col("price").cast("double"))
df = df.withColumn("revenue", col("price"))   # can extend later (price * quantity)

# Write output in Parquet format
df.write.mode("overwrite") \
    .parquet(processed_path)

print("ETL Pipeline executed successfully")

