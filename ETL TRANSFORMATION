# 🧠 etl_job.py (basic working template)

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import col, sum as _sum

spark = SparkSession.builder.appName("ETL Pipeline").getOrCreate()

# Load data from S3
orders = spark.read.csv("s3://your-bucket/orders.csv", header=True)
order_items = spark.read.csv("s3://your-bucket/order_items.csv", header=True)
customers = spark.read.csv("s3://your-bucket/customers.csv", header=True)

# Join tables
df = orders.join(order_items, "order_id") \
           .join(customers, "customer_id")

# Transformations
df = df.withColumn("revenue", col("price") * col("quantity"))

# Aggregation
result = df.groupBy("customer_id") \
           .agg(_sum("revenue").alias("total_revenue"))

# Write to S3 (Parquet)
result.write.mode("overwrite").parquet("s3://your-bucket/processed/")
