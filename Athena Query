----Database create----
CREATE DATABASE olist_db;
----External table location----
ALTER TABLE olist_orders_processed
SET LOCATION 's3://olist-data-gargi-mumbai/output-check/';
---- Sample data check--
SELECT * FROM olist_orders_processed LIMIT 5;
----Top customers-----
SELECT customer_id,
       SUM(revenue) AS total_revenue
FROM olist_orders_processed
GROUP BY customer_id
ORDER BY total_revenue DESC
LIMIT 5;
-----Total revenue---
SELECT SUM(revenue) AS total_revenue
FROM olist_orders_processed;
------Top customers by orders----
SELECT customer_id,
       COUNT(order_id) AS total_orders
FROM olist_orders_processed
GROUP BY customer_id
ORDER BY total_orders DESC
LIMIT 5;
